{
  "name": "kremle-react",
  "version": "2.7.1",
  "description": "React captcha for the kremle-detect web filter",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.0.0",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "captcha",
    "yandex",
    "react",
    "kremle-detect",
    "bot-protection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RUdolf1517/KremleXYZ-Detect.git",
    "directory": "kremle-react"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/RUdolf1517/KremleXYZ-Detect#react-компонент",
  "bugs": {
    "url": "https://github.com/RUdolf1517/KremleXYZ-Detect/issues"
  }
}
